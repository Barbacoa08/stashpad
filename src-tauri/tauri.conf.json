{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scratchtree",
  "version": "0.1.0",
  "identifier": "tech.barbajoe.scratchtree.preview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:4511",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Scratchtree",
        "width": 1100,
        "height": 760,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"]
  }
}
